# Which documentary sources justify a given material assignment or modelling assumption?
#
# Competency question CQ7 of the manuscript.

PREFIX petras: <https://w3id.org/petras/ontology#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?source ?operator ?justifies WHERE {
  ?source petras:inLayer petras:DataSources .
  ?link petras:mapsFrom ?source ;
        petras:mapsTo   ?justifies ;
        petras:operator ?operator .
}
ORDER BY ?source
